<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Transaksi</title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        * { 
            box-sizing: border-box; 
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
        }
        
        :root {
            --neo-bg: #e6ecf5;
            --neo-shadow-dark: #b8c4d5;
            --neo-shadow-light: #ffffff;
            --brand-blue: #0088ff;
            --text-dark: #334155;
            --text-muted: #64748b;
        }

        body { 
            background-color: var(--neo-bg); 
            margin: 0; 
            padding: 12px; 
            padding-bottom: 70px; /* Space untuk bottom nav */
            color: var(--text-dark); 
        }
        
        @keyframes popupFromBottom {
            0% { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .filter-wrapper {
            position: sticky;
            top: 0;
            z-index: 100;
            background-color: var(--neo-bg);
            padding: 4px 0 10px 0;
            margin-bottom: 6px;
        }

        .filter-container {
            display: flex;
            gap: 6px;
            padding: 5px;
            background: var(--neo-bg);
            border-radius: 30px;
            box-shadow: inset 3px 3px 6px var(--neo-shadow-dark), inset -3px -3px 6px var(--neo-shadow-light);
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .filter-container::-webkit-scrollbar { display: none; }

        .tab-filter {
            flex: 1;
            white-space: nowrap;
            text-align: center;
            padding: 7px 12px;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            background: transparent;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
        }

        .tab-filter.active {
            color: var(--brand-blue); 
            background: var(--neo-bg);
            box-shadow: 3px 3px 6px var(--neo-shadow-dark), -3px -3px 6px var(--neo-shadow-light);
        }

        .date-group {
            margin-top: 14px;
            margin-bottom: 8px;
        }

        .date-header {
            display: inline-block;
            font-size: 10px;
            font-weight: 800;
            color: var(--brand-blue);
            background: var(--neo-bg);
            padding: 4px 12px;
            border-radius: 12px;
            box-shadow: inset 2px 2px 4px var(--neo-shadow-dark), inset -2px -2px 4px var(--neo-shadow-light);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card {
            background: var(--neo-bg);
            border-radius: 16px;
            padding: 10px 14px;
            margin-bottom: 10px;
            box-shadow: 5px 5px 10px var(--neo-shadow-dark), -5px -5px 10px var(--neo-shadow-light);
            animation: popupFromBottom 0.25s ease forwards;
            cursor: pointer;
            transition: all 0.15s ease;
            -webkit-tap-highlight-color: transparent;
            border: none;
        }

        .card:active {
            box-shadow: inset 3px 3px 6px var(--neo-shadow-dark), inset -3px -3px 6px var(--neo-shadow-light);
            transform: scale(0.985);
        }

        .card-body-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .card-left { flex: 1; min-width: 0; }
        .card-right { display: flex; align-items: center; gap: 10px; }

        .header-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 10px;
            margin-bottom: 3px;
        }

        .tx-id { color: var(--text-muted); font-weight: 600; }
        .tx-target { color: var(--brand-blue); font-weight: 700; display: inline-flex; align-items: center; gap: 3px; }

        .produk-title { 
            font-weight: 700; 
            font-size: 12px; 
            color: var(--text-dark); 
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .produk-status-kirim { 
            font-size: 10px; 
            color: var(--text-muted); 
            margin-top: 3px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 8px;
            font-size: 9px;
            text-transform: uppercase;
            background: var(--neo-bg);
            box-shadow: inset 2px 2px 4px var(--neo-shadow-dark), inset -2px -2px 4px var(--neo-shadow-light);
            white-space: nowrap;
        }

        .status-lunas { color: #10b981; }
        .status-pending { color: #f59e0b; }
        .status-batal { color: #ef4444; }

        .btn-arrow {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--neo-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand-blue);
            font-size: 11px;
            box-shadow: 3px 3px 6px var(--neo-shadow-dark), -3px -3px 6px var(--neo-shadow-light);
            flex-shrink: 0;
        }
        
        .info-text { 
            text-align: center; 
            color: var(--text-muted); 
            margin-top: 24px; 
            font-size: 12px; 
        }
    </style>
</head>
<body>

<div class="filter-wrapper">
    <div class="filter-container">
        <div class="tab-filter active" onclick="filterKategori('semua', this)">Semua</div>
        <div class="tab-filter" onclick="filterKategori('sukses', this)">Sukses</div>
        <div class="tab-filter" onclick="filterKategori('pending', this)">Pending</div>
        <div class="tab-filter" onclick="filterKategori('batal', this)">Batal</div>
    </div>
</div>

<div id="app">
    <div class="info-text" id="status-text">Memuat riwayat transaksi...</div>
</div>

<script>
    let totalData = [];
    let kategoriAktif = "semua";

    function filterKategori(kategori, el) {
        kategoriAktif = kategori;
        document.querySelectorAll('.tab-filter').forEach(tab => tab.classList.remove('active'));
        if (el) el.classList.add('active');
        renderData(totalData);
    }

    async function muatTransaksiVPS() {
        const container = document.getElementById("app");
        
        try {
            // Ambil nomor HP user yang sedang login dari localStorage
            const userSession = JSON.parse(localStorage.getItem('arcell_user') || '{}');
            const hp = userSession.hp || '';

            // Panggil API Backend Server VPS kamu
            const response = await fetch(`/api/history?hp=${encodeURIComponent(hp)}`);
            const res = await response.json();

            if (res.status === 'success' && res.data && res.data.length > 0) {
                totalData = res.data;
                renderData(totalData);
            } else {
                container.innerHTML = '<div class="info-text">Belum ada riwayat transaksi.</div>';
            }
        } catch (err) {
            console.error(err);
            container.innerHTML = '<div class="info-text">Gagal terhubung ke Server VPS.</div>';
        }
    }

    function renderData(list) {
        const container = document.getElementById("app");
        
        const dataFiltered = list.filter(item => {
            const st = (item.status || "SUKSES").toLowerCase();
            if (kategoriAktif === "sukses") return st === "sukses" || st === "lunas";
            if (kategoriAktif === "pending") return st === "pending" || st === "proses";
            if (kategoriAktif === "batal") return st === "batal" || st === "gagal";
            return true;
        });

        if (dataFiltered.length === 0) {
            container.innerHTML = `<div class="info-text">Tidak ada transaksi untuk kategori <b>${kategoriAktif.toUpperCase()}</b>.</div>`;
            return;
        }

        // Kelompokkan berdasarkan tanggal/waktu
        const groupedData = {};
        dataFiltered.forEach(item => {
            const dateKey = item.waktu ? item.waktu.split(',')[0] : 'Hari Ini';
            if (!groupedData[dateKey]) groupedData[dateKey] = [];
            groupedData[dateKey].push(item);
        });

        let htmlList = "";

        for (const dateKey in groupedData) {
            htmlList += `
                <div class="date-group">
                    <div class="date-header"><i class="bi bi-calendar3 me-1"></i> ${dateKey}</div>
            `;

            groupedData[dateKey].forEach(item => {
                const statusStr = (item.status || "SUKSES").toUpperCase();
                let statusClass = "status-lunas";

                if (statusStr === "PENDING" || statusStr === "PROSES") statusClass = "status-pending";
                if (statusStr === "BATAL" || statusStr === "GAGAL") statusClass = "status-batal";

                const jam = item.waktu && item.waktu.includes(',') ? item.waktu.split(',')[1] : '';

		htmlList += `
		    <div class="card" onclick="window.location.href='detail.html?id=${encodeURIComponent(item.ref_id)}'">
        	<div class="header-meta">
            <span class="tx-id">#${item.ref_id || 'ARC'}</span>
            ${jam ? `<span style="color:var(--text-muted); font-weight:600;">• ${jam}</span>` : ''}
            ${item.no_tujuan ? `<span class="tx-target"><i class="bi bi-phone"></i>${item.no_tujuan}</span>` : ''}
        </div>
        <div class="card-body-content">
            <div class="card-left">
                <div class="produk-title">${item.produk || item.sku || 'Produk PPOB'}</div>
                <div class="produk-status-kirim"><i class="bi bi-receipt me-1"></i>{}</div>
            </div>
            <div class="card-right">
                <span class="status ${statusClass}">${statusStr}</span>
                <div class="btn-arrow"><i class="bi bi-chevron-right"></i></div>
            </div>
        </div>
    </div>
   `;


            });

            htmlList += `</div>`;
        }
        
        container.innerHTML = htmlList;
    }

    document.addEventListener("DOMContentLoaded", muatTransaksiVPS);
</script>

</body>
</html>

