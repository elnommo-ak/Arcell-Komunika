const express = require('express');
const cors = require('cors');
const path = require('path');
const fs = require('fs').promises;
const fsSync = require('fs');
const crypto = require('crypto');
const axios = require('axios');
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 3000;

// Trust Proxy agar IP dibaca dengan benar di balik Nginx / VPS
app.set('trust proxy', true);

// Middleware
app.use(cors());
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// Serve File Statis dari Folder Public
app.use(express.static(path.join(__dirname, 'public')));

// Lokasi Penyimpanan File JSON
const TRX_FILE = path.join(__dirname, 'transactions.json');

// Helper Simpan & Update Transaksi Lokal (Async)
async function saveTransactionToHistory(trxData) {
    try {
        let history = [];
        if (fsSync.existsSync(TRX_FILE)) {
            const content = await fs.readFile(TRX_FILE, 'utf8');
            history = JSON.parse(content || '[]');
        }
        
        const index = history.findIndex(t => t.ref_id === trxData.ref_id);
        if (index !== -1) {
            history[index] = { ...history[index], ...trxData };
        } else {
            history.unshift(trxData);
        }

        await fs.writeFile(TRX_FILE, JSON.stringify(history, null, 2), 'utf8');
    } catch (err) {
        console.error("Gagal menyimpan transaksi ke file:", err.message);
    }
}

// ========================================================
// 📌 1. API CEK SALDO DIGIFLAZZ (SAFE VERSION)
// ========================================================
app.get('/api/saldo', async (req, res) => {
    try {
        const username = (process.env.DIGIFLAZZ_USERNAME || '').trim();
        const apiKey = (process.env.DIGIFLAZZ_API_KEY || '').trim();

        if (!username || !apiKey) {
            return res.json({ status: 'error', deposit: 0, message: 'API Key belum di-config' });
        }

        const sign = crypto.createHash('md5').update(username + apiKey + "depo").digest('hex');

        // Request ke Digiflazz
        const response = await axios.post('https://api.digiflazz.com/v1/cek-saldo', {
            cmd: 'deposit',
            username: username,
            sign: sign
        }, { timeout: 8000 }); // Timeout diset 8 detik

        // Ambil data deposit dari respon Digiflazz
        const depositAmount = response.data && response.data.data ? response.data.data.deposit : 0;

        return res.json({ 
            status: 'success', 
            deposit: depositAmount,
            data: response.data.data 
        });

    } catch (error) {
        // Tangkap error timeout/koneksi tanpa merusak (crash) server
        console.warn("⚠️ Gagal/Timeout Cek Saldo Digiflazz:", error.message);

        // Berikan nilai deposit 0 agar tampilan frontend tetap berjalan normal
        return res.json({ 
            status: 'warning', 
            deposit: 0, 
            message: 'Koneksi ke Digiflazz lambat/timeout' 
        });
    }
});


// ========================================================
// 📌 2. API DAFTAR HARGA / PRODUK DIGIFLAZZ
// ========================================================
app.post('/api/digiflazz/price-list', async (req, res) => {
    try {
        const username = (process.env.DIGIFLAZZ_USERNAME || '').trim();
        const apiKey = (process.env.DIGIFLAZZ_API_KEY || '').trim();
        const sign = crypto.createHash('md5').update(username + apiKey + "pricelist").digest('hex');

        const response = await axios.post('https://api.digiflazz.com/v1/price-list', {
            cmd: 'prepaid',
            username: username,
            sign: sign
        }, { timeout: 15000 });

        let products = response.data.data || [];

        // 📌 SIMPAN / REFRESH DATABASE PRODUK LOKAL AUTOMATIS
        if (products.length > 0) {
            const PRODUCTS_FILE = path.join(__dirname, 'products.json');
            await fs.writeFile(PRODUCTS_FILE, JSON.stringify(products, null, 2), 'utf8');
        }

        return res.json({ status: 'success', data: products });
    } catch (error) {
        return res.status(500).json({ status: 'error', message: error.message, data: [] });
    }
});

// Route khusus untuk dibaca oleh frontend index.html
app.get('/api/products', async (req, res) => {
    try {
        const PRODUCTS_FILE = path.join(__dirname, 'products.json');
        const data = await fs.readFile(PRODUCTS_FILE, 'utf8');
        return res.json(JSON.parse(data));
    } catch (error) {
        return res.json([]);
    }
});

// ========================================================
// 📌 ENDPOINT UPDATE KATEGORI PRODUK SECARA MASSAL (CHECKBOX)
// ========================================================
app.post('/api/admin/update-category', async (req, res) => {
    try {
        const { skus, categoryName } = req.body;

        if (!skus || !Array.isArray(skus) || !categoryName) {
            return res.status(400).json({ status: 'error', message: 'Payload tidak lengkap' });
        }

        const PRODUCTS_FILE = path.join(__dirname, 'products.json');
        const rawData = await fs.readFile(PRODUCTS_FILE, 'utf8');
        let products = JSON.parse(rawData);

        let updatedCount = 0;

        // Loop dan ubah tipe/kategori produk yang dicentang
        products = products.map(p => {
            const currentSku = p.buyer_sku_code || p.sku;
            if (skus.includes(currentSku)) {
                p.type = categoryName; // Ubah tipe/tab paket
                p.category = categoryName;
                updatedCount++;
            }
            return p;
        });

        // Simpan kembali ke products.json
        await fs.writeFile(PRODUCTS_FILE, JSON.stringify(products, null, 2), 'utf8');

        return res.json({
            status: 'success',
            message: 'Kategori berhasil diperbarui',
            updatedCount: updatedCount
        });

    } catch (error) {
        console.error("Error update category:", error);
        return res.status(500).json({ status: 'error', message: error.message });
    }
});

