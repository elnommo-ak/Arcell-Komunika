            payload.testing = false;
        }

        const response = await axios.post('https://api.digiflazz.com/v1/transaction', payload, { timeout: 15000 });

        const digiData = response.data ? response.data.data : null;
        const statusTx = digiData ? (digiData.status || 'PROSES').toUpperCase() : 'PENDING';
        const snValue = digiData ? (digiData.sn || digiData.message || '-') : '-';

        // 2. Hitung harga modal & harga jual dengan benar
        const hargaModal = digiData && digiData.price ? Number(digiData.price) : 0;
        // Gunakan harga jual dari frontend/request, atau hitung markup otomatis jika kosong
        const hargaJual = reqSellingPrice 
            ? Number(reqSellingPrice)
            : (hargaModal > 0 ? Math.ceil((hargaModal + 2000) / 500) * 500 : 0);

