app.post('/api/digiflazz/checkout', (req, res) => {
    const { buyer_sku_code, product_name, customer_no, ref_id } = req.body;

    const newTrx = {
        ref_id: ref_id || 'TRX-' + Date.now(),
        member_id: 'ARC001',
        member_name: 'Member Contoh',
        product_name: product_name || buyer_sku_code,
        customer_no: customer_no,
        price: 12000,
        status: 'sukses',
        date: new Date().toISOString()
    };

    dbTransactions.unshift(newTrx); // Masukkan ke urutan teratas
    dbSaldoServer -= 10000; // Kurangi saldo server

    res.json({
        status: 'success',
        message: 'Transaksi berhasil diproses',
        data: newTrx
    });
});

// ==========================================
// API GET PROFILE / SALDO MEMBER UTAMA
// ==========================================
app.get('/api/member/profile', async (req, res) => {
    try {
        const phone = req.query.phone; // Dikirim dari frontend index.html
        const MEMBERS_FILE = path.join(__dirname, 'members.json');
        
        let members = [];
        try {
            const raw = await fs.readFile(MEMBERS_FILE, 'utf8');
            members = JSON.parse(raw);
        } catch (e) {
            members = [];
        }

        // Cari data member berdasarkan No HP
        const user = members.find(m => m.phone === phone || m.nohp === phone);

        if (user) {
            return res.json({
                status: 'success',
                data: {
                    name: user.name,
                    phone: user.phone,
                    balance: parseFloat(user.balance || 0),
                    member_id: user.member_id
                }
            });
        } else {
            // Jika member baru/belum ada di database
            return res.json({
                status: 'success',
                data: {
                    name: 'Sahabat Arcell',
                    phone: phone || '-',
                    balance: 0,
                    member_id: 'ARC' + Math.floor(1000 + Math.random() * 9000)
                }
            });
        }
    } catch (error) {
        return res.status(500).json({ status: 'error', message: error.message });
    }
});

// ========================================================
// 📌 START SERVER ON PORT 3000
// ========================================================
app.listen(PORT, '0.0.0.0', () => {
    console.log(`========================================`);
    console.log(`🚀 Arcell Engine Active on Port ${PORT}`);
    console.log(`========================================`);
});

